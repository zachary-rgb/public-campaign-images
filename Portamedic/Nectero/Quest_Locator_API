function onFormSubmit(e) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const formSheet = ss.getSheetByName("Form Responses 1");
  const outputSheet = ss.getSheetByName("Quest_Locations") || ss.insertSheet("Quest_Locations");

  // --- Form values ---
  const row = e.range.getRow();
  const zipRaw = formSheet.getRange(row, 1).getValue();
  const email = formSheet.getRange(row, 2).getValue();
  if (!zipRaw || !email) return;

  const zip = String(zipRaw).padStart(5, "0");

  // --- Endpoint 1: PSC info ---
  const pscUrl = `https://api.tryvital.io/v3/order/psc/info?lab_id=7&radius=50&zip_code=${zip}`;
  let json;
  try {
    const response = UrlFetchApp.fetch(pscUrl, {
      method: "get",
      headers: {
        "Accept": "application/json",
        "x-vital-api-key": "pk_us_IZBQd4WTLDH2cLzRnU8CVvqDuEDL05rwQLY8fynMmh0"
      },
      muteHttpExceptions: true
    });
    if (response.getResponseCode() === 200) {
      json = JSON.parse(response.getContentText());
    } else {
      Logger.log(`PSC info error ${response.getResponseCode()}: ${response.getContentText()}`);
      return;
    }
  } catch (err) {
    Logger.log(`Error fetching PSC info for ZIP ${zip}: ${err}`);
    return;
  }

 // --- Endpoint 2: Area info (phlebotomy availability + third-party logic) ---
const availUrl = `https://api.tryvital.io/v3/order/area/info?lab=quest&radius=50&zip_code=${zip}`;
let phlebotomyServed = "No";
let thirdPartyAvailable = "No";

const centers = (json && json.patient_service_centers) || [];

try {
  const response2 = UrlFetchApp.fetch(availUrl, {
    method: "get",
    headers: {
      "Accept": "application/json",
      "x-vital-api-key": "pk_us_IZBQd4WTLDH2cLzRnU8CVvqDuEDL05rwQLY8fynMmh0"
    },
    muteHttpExceptions: true
  });

  if (response2.getResponseCode() === 200) {
    const json2 = JSON.parse(response2.getContentText());
    Logger.log("Area info response:", JSON.stringify(json2, null, 2));

    // --- ✅ Phlebotomy served check ---
    if (json2.phlebotomy && json2.phlebotomy.is_served === true) {
      phlebotomyServed = "Yes";
    }

    // --- ✅ Third-party logic ---
    // If phlebotomy.is_served = false and a Quest PSC is within 40 miles
    const nearbyQuest = centers.some(c => {
      const d = Number(c.distance);
      return !isNaN(d) && d <= 40;
    });

    if (json2.phlebotomy && json2.phlebotomy.is_served === false && nearbyQuest) {
      thirdPartyAvailable = "Yes";
    }

  } else {
    Logger.log(`Area info error ${response2.getResponseCode()}: ${response2.getContentText()}`);
  }

} catch (err) {
  Logger.log(`Error fetching area info for ZIP ${zip}: ${err}`);
}

// --- Determine state dynamically using Zippopotam.us lookup ---
let primaryState = "";
try {
  const zipLookup = UrlFetchApp.fetch(`https://api.zippopotam.us/us/${zip}`, { muteHttpExceptions: true });
  if (zipLookup.getResponseCode() === 200) {
    const zipJson = JSON.parse(zipLookup.getContentText());
    primaryState = (zipJson.places && zipJson.places[0]["state abbreviation"]) || "";
    Logger.log(`📍 ZIP ${zip} resolved to state ${primaryState}`);
  } else {
    Logger.log(`⚠️ ZIP lookup failed (${zipLookup.getResponseCode()}) for ${zip}`);
  }
} catch (err) {
  Logger.log(`❌ ZIP lookup error for ${zip}: ${err}`);
}

// --- Restriction rule for NY, NJ, RI ---
const restrictedStates = ["NY", "NJ", "RI"];
let isRestricted = restrictedStates.includes(primaryState.toUpperCase());

if (isRestricted) {
  Logger.log(`🚫 ${primaryState}: Hard override — no Curebase mobile or Quest walk-in scheduling allowed.`);

  // --- Simple, concise email (no table) ---
const htmlBody = `
  <div style="font-family:Arial, sans-serif; color:#222; font-size:15px; line-height:1.5;">
    <p>Hello,</p>

    <div style="background-color:#f8d7da; color:#721c24; padding:12px 16px; 
                border-radius:6px; margin:16px 0; font-weight:bold;">
      🚫 ${zip}: Lab orders cannot be completed for ${primaryState}.
    </div>

    <p style="margin-top:20px;">
      Please review the Sponsor-provided training materials, or if required, contact
      <a href="mailto:east002@curebase.com" style="color:#721c24; text-decoration:underline;">
        Curebase Support
      </a> for next steps.
    </p>
  </div>
`;

  MailApp.sendEmail({
    to: email,
    cc: "labs@necteromedical.com, zachary@curebase.com",
    subject: `Curebase Phlebotomy Unavailable for ZIP ${zip}`,
    htmlBody: htmlBody,
    name: "EAST-002 Curebase Team",
    replyTo: "east002@curebase.com"
  });

  // --- Ensure no table or downstream logic runs ---
  return;
}

  // --- Sheet headers ---
  const headers = [
    "Name", "First Line", "Second Line", "City", "State",
    "Phone", "Fax", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun",
    "Distance (mi)", "Run Date", "Entered ZIP", "Email", "Mobile Phlebotomy scheduling in Curebase?"
  ];
  if (outputSheet.getLastRow() === 0) {
    outputSheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  }

    // --- No centers case (no Quest within 50mi) ---
  if (!centers.length) {
    const nextRow = outputSheet.getLastRow() + 1;
    outputSheet.getRange(nextRow, 1, 1, 3)
      .setValues([["No results found", new Date(), zip]]);

    const phlebColor = phlebotomyServed === "Yes" ? "#228B22" : "#B22222";
    const thirdColor = thirdPartyAvailable === "Yes" ? "#228B22" : "#B22222";

    let htmlBody = `
      <p>Hello,</p>

        <h3 style="font-family:Arial; color:#1a1a1a;">🧪 Curebase Phlebotomy Availability Summary</h3>
  <table border="1" cellpadding="6" cellspacing="0" 
         style="border-collapse:collapse; border:1px solid #ddd; font-family:Arial; font-size:14px; width:100%; max-width:640px;">
    <tr style="background-color:#f9f9f9;">
      <th align="left">Type</th>
      <th align="left">Availability</th>
      <th align="left">Notes</th>
    </tr>
    ${phlebotomyServed === "No" ? `
      <tr>
        <td colspan="3" style="background-color:#fff8dc; color:#b8860b; font-weight:bold; text-align:center;">
          ⚠️ Mobile phlebotomy options are not available for this ZIP.
        </td>
      </tr>` : ""}
    <tr>
      <td><b>Mobile Phlebotomy (scheduled in Curebase)</b></td>
      <td style="color:${phlebotomyServed === "Yes" ? "#228B22" : "#B22222"}; font-weight:bold;">
        ${phlebotomyServed === "Yes" ? "✅ Available" : "❌ Not Available"}
      </td>
      <td>${phlebotomyServed === "Yes"
        ? "Participants in this ZIP can be scheduled directly in Curebase for Mobile Phlebotomy."
        : "Participants in this ZIP cannot be scheduled for Mobile Phlebotomy in Curebase."}
      </td>
    </tr>
    <tr>
      <td><b>Third-Party Mobile Option</b></td>
      <td style="color:${thirdPartyAvailable === "Yes" ? "#228B22" : "#B22222"}; font-weight:bold;">
        ${thirdPartyAvailable === "Yes" ? "✅ Available" : "❌ Not Available"}
      </td>
      <td>${thirdPartyAvailable === "Yes"
        ? 'Third-party mobile phlebotomy is available; please <a href="https://forms.gle/5mT1ML9NGABBBgAk9" target="_blank">select desired appointments here</a>.'
        : "No third-party mobile coverage for this ZIP."}
      </td>
    </tr>
  </table>
   <p style="background-color:#fff8dc; color:#b8860b; font-weight:bold; 
          text-align:center; padding:10px; border-radius:6px; 
          margin-top:16px; font-family:Arial; font-size:15px;">
  ⚠️ No Quest Diagnostics locations were found within 50 miles of ZIP <b>${zip}</b>.<br>
 
  Please contact <a href="mailto:east002@curebase.com" style="color:#b8860b; text-decoration:underline;">
    Curebase Support
  </a> for assistance with next steps.
</p>

    `;

    MailApp.sendEmail({
      to: email,
      cc: "labs@necteromedical.com, zachary@curebase.com",
      subject: `Quest Diagnostics Availability for ZIP ${zip}`,
      htmlBody: htmlBody,
      name: "EAST-002 Curebase Team",
      replyTo: "east002@curebase.com"
    });
    return;
  }


// --- Limit to 5 closest Quest locations ---
centers.sort((a, b) => {
  const da = Number(a.distance);
  const db = Number(b.distance);
  if (isNaN(da) && isNaN(db)) return 0;
  if (isNaN(da)) return 1;
  if (isNaN(db)) return -1;
  return da - db;
});
const limitedCenters = centers.slice(0, 5);

  // --- Flatten PSC rows ---
  const rows = limitedCenters.map(c => {
    const m = c.metadata || {};
    const h = m.hours || {};
    let distance = "";
    if (c.distance === 0) distance = "<1";
    else if (typeof c.distance === "number") distance = Number(c.distance).toFixed(1);

    return [
      m.name || "",
      m.first_line || "",
      m.second_line || "",
      m.city || "",
      m.state || "",
      m.phone_number || "",
      m.fax_number || "",
      h.Mon || "",
      h.Tue || "",
      h.Wed || "",
      h.Thu || "",
      h.Fri || "",
      h.Sat || "",
      h.Sun || "",
      distance,
      new Date(),
      zip,
      email,
      phlebotomyServed
    ];
  });

  // --- write to sheet ---
  const nextRow = outputSheet.getLastRow() + 1;
  outputSheet.getRange(nextRow, 1, rows.length, headers.length).setValues(rows);
  outputSheet.autoResizeColumns(1, headers.length);

 // --- Build email (always show table here) ---
const phlebColor = phlebotomyServed === "Yes" ? "#228B22" : "#B22222";

let htmlBody = `
  <p>Hello,</p>

  <h3 style="font-family:Arial; color:#1a1a1a;">🧪 Curebase Phlebotomy Availability Summary</h3>
  <table border="1" cellpadding="6" cellspacing="0" 
         style="border-collapse:collapse; border:1px solid #ddd; font-family:Arial; font-size:14px; width:100%; max-width:640px;">
    <tr style="background-color:#f9f9f9;">
      <th align="left">Type</th>
      <th align="left">Availability</th>
      <th align="left">Notes</th>
    </tr>
    ${(phlebotomyServed === "No" && thirdPartyAvailable === "No") ? `
      <tr>
        <td colspan="3" style="background-color:#fff8dc; color:#b8860b; font-weight:bold; text-align:center;">
          ⚠️ Mobile phlebotomy options are not available for this ZIP.
        </td>
      </tr>` : ""}
    <tr>
      <td><b>Mobile Phlebotomy (scheduled in Curebase)</b></td>
      <td style="color:${phlebColor}; font-weight:bold;">
        ${phlebotomyServed === "Yes" ? "✅ Available" : "❌ Not Available"}
      </td>
      <td>${phlebotomyServed === "Yes"
        ? "Participants in this ZIP can be scheduled directly in Curebase for Mobile Phlebotomy."
        : "Participants in this ZIP cannot be scheduled for Mobile Phlebotomy in Curebase."}
      </td>
    </tr>
`;

// --- Only show Third-Party section if Curebase mobile is NOT available ---
if (phlebotomyServed === "No") {
  htmlBody += `
    <tr>
      <td><b>Third-Party Mobile Option</b></td>
      <td style="color:${thirdPartyAvailable === "Yes" ? "#228B22" : "#B22222"}; font-weight:bold;">
        ${thirdPartyAvailable === "Yes" ? "✅ Available" : "❌ Not Available"}
      </td>
      <td>${thirdPartyAvailable === "Yes"
        ? 'Third-party mobile phlebotomy is available; please <a href="https://forms.gle/5mT1ML9NGABBBgAk9" target="_blank">select desired appointments here</a>.'
        : "No third-party mobile coverage for this ZIP."}
      </td>
    </tr>
  `;
}


htmlBody += `
  </table>

  <p style="margin-top:16px;">
    <b>Here are the nearest Quest Diagnostics locations for ZIP ${zip} for the purposes of Walk-in orders.</b><br>
    The Requisition Form will be available for download in the Curebase platform.
  </p>

  <table border="1" cellpadding="4" cellspacing="0" style="border-collapse:collapse; border:1px solid #ccc;">
    <tr style="background-color:#f2f2f2;">
      <th>Name</th>
      <th>Address (click to open map)</th>
      <th>City</th>
      <th>State</th>
      <th>Phone</th>
      <th>Distance (mi)</th>
      <th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th><th>Sun</th>
    </tr>
`;

  rows.forEach(r => {
    const address = `${r[1]} ${r[2]}, ${r[3]}, ${r[4]}`;
    const mapsLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
    const distance = r[14] ? (r[14] === "<1" ? "&lt;1 mi" : r[14] + " mi") : "";

    htmlBody += `
      <tr>
        <td>${r[0]}</td>
        <td><a href="${mapsLink}" target="_blank">${r[1]} ${r[2]}</a></td>
        <td>${r[3]}</td>
        <td>${r[4]}</td>
        <td>${r[5]}</td>
        <td>${distance}</td>
        <td>${!r[7]  || r[7]  === "null" ? "<span style='color:gray;font-style:italic;'>Closed</span>" : r[7]}</td>
        <td>${!r[8]  || r[8]  === "null" ? "<span style='color:gray;font-style:italic;'>Closed</span>" : r[8]}</td>
        <td>${!r[9]  || r[9]  === "null" ? "<span style='color:gray;font-style:italic;'>Closed</span>" : r[9]}</td>
        <td>${!r[10] || r[10] === "null" ? "<span style='color:gray;font-style:italic;'>Closed</span>" : r[10]}</td>
        <td>${!r[11] || r[11] === "null" ? "<span style='color:gray;font-style:italic;'>Closed</span>" : r[11]}</td>
        <td>${!r[12] || r[12] === "null" ? "<span style='color:gray;font-style:italic;'>Closed</span>" : r[12]}</td>
        <td>${!r[13] || r[13] === "null" ? "<span style='color:gray;font-style:italic;'>Closed</span>" : r[13]}</td>
      </tr>
    `;
  });

  htmlBody += `
    </table>
    <p style="margin-top:12px;">Thank you for your submission. Please reply to this email with any questions.</p>
  `;

MailApp.sendEmail({
  to: email,
  cc: "labs@necteromedical.com, zachary@curebase.com",
  subject: `Quest Diagnostics Locations for ZIP ${zip}`,
  htmlBody: htmlBody,
  name: "EAST-002 Curebase Team",
  replyTo: "east002@curebase.com"
});
}
