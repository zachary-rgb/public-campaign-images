# Image-only repository for campaign assets
# Only campaign_images_* folders inside JSONGenerator are tracked

# Ignore everything at root
/*

# EXCEPT: Allow these at root
!/.gitignore
!/README.md
!/JSONGenerator/

# Inside JSONGenerator, ignore everything
/JSONGenerator/*

# EXCEPT: Allow campaign_images_* folders
!/JSONGenerator/campaign_images_*/
!/JSONGenerator/campaign_images_*/**

# ===========================================
# Everything below is always ignored
# ===========================================

# Python artifacts
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.Python
**/pip-log.txt
**/*.egg-info/
**/.pytest_cache/

# IDE and system files
**/.vscode/
**/.idea/
**/*.swp
**/*.swo
**/*~
**/.DS_Store
**/Thumbs.db

# Project files (always keep private)
**/*.docx
**/*.xlsx
**/*.xls
**/*.tsv
**/*.json
**/*.md
!README.md
**/*.py
**/*.txt
**/*.bat
**/*.vba

# Keep credentials and config files private
**/credentials.json
**/token.json
**/.env
**/config.ini
